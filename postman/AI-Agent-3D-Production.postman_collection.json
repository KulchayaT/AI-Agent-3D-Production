{
  "info": {
    "name": "AI Agent 3D Production - QA API",
    "description": "Section 4.2 test scenarios T1-T5 plus health and job tracker. Start the API first: uvicorn api.main:app --reload",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "base_url", "value": "http://127.0.0.1:8000" }],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{base_url}}/v1/health" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 and model ready', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().model_ready).to.eql(true); });"
      ] } }]
    },
    {
      "name": "T1 raw Tripo mesh -> FAIL",
      "request": {
        "method": "POST", "url": "{{base_url}}/v1/assess",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"asset_id\": \"char_tripo_raw\",\n  \"file_url\": \"samples/char_tripo_raw.glb\",\n  \"context\": {\"platform\": \"PC\", \"engine\": \"UE5\", \"asset_role\": \"hero_character\"}\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "const b = pm.response.json();",
        "pm.test('200 FAIL', () => { pm.response.to.have.status(200); pm.expect(b.status).to.eql('FAIL'); });",
        "pm.test('UV fragmented issue sent to 3D Modeler C', () => { pm.expect(b.issues.map(i => i.code)).to.include('UV_FRAGMENTED'); pm.expect(b.next_action.agent).to.eql('3d_modeler_c'); });"
      ] } }]
    },
    {
      "name": "T2 mesh after Modeler C -> PASS",
      "request": {
        "method": "POST", "url": "{{base_url}}/v1/assess",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"asset_id\": \"char_fixed\",\n  \"file_url\": \"samples/char_fixed.glb\",\n  \"context\": {\"platform\": \"PC\", \"engine\": \"UE5\", \"asset_role\": \"hero_character\"}\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "const b = pm.response.json();",
        "pm.test('200 PASS score >= 80', () => { pm.response.to.have.status(200); pm.expect(b.status).to.eql('PASS'); pm.expect(b.readiness_score).to.be.at.least(80); });"
      ] } }]
    },
    {
      "name": "T3 missing context.platform -> 400",
      "request": {
        "method": "POST", "url": "{{base_url}}/v1/assess",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"asset_id\": \"char_fixed\",\n  \"file_url\": \"samples/char_fixed.glb\",\n  \"context\": {\"engine\": \"UE5\", \"asset_role\": \"hero_character\"}\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('400 names the field', () => { pm.response.to.have.status(400); pm.expect(JSON.stringify(pm.response.json().error.details)).to.include('context.platform'); });"
      ] } }]
    },
    {
      "name": "T4 image instead of mesh -> 415",
      "request": {
        "method": "POST", "url": "{{base_url}}/v1/assess",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"asset_id\": \"concept\",\n  \"file_url\": \"samples/concept.png\",\n  \"context\": {\"platform\": \"PC\", \"engine\": \"UE5\", \"asset_role\": \"hero_character\"}\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('415', () => pm.response.to.have.status(415));"
      ] } }]
    },
    {
      "name": "T5 mesh without UV -> 422",
      "request": {
        "method": "POST", "url": "{{base_url}}/v1/assess",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"asset_id\": \"no_uv\",\n  \"file_url\": \"samples/no_uv.glb\",\n  \"context\": {\"platform\": \"PC\", \"engine\": \"UE5\", \"asset_role\": \"hero_character\"}\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('422 MESH_HAS_NO_UV', () => { pm.response.to.have.status(422); pm.expect(pm.response.json().error.code).to.eql('MESH_HAS_NO_UV'); });"
      ] } }]
    },
    {
      "name": "Create job (simulated agents) -> 202",
      "request": {
        "method": "POST", "url": "{{base_url}}/v1/jobs",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"prompt\": \"chibi cat adventurer with a green beanie\",\n  \"context\": {\"platform\": \"PC\", \"engine\": \"UE5\", \"asset_role\": \"hero_character\"}\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('202', () => pm.response.to.have.status(202));",
        "pm.collectionVariables.set('job_id', pm.response.json().job_id);"
      ] } }]
    },
    {
      "name": "Job progress (Production Tracker)",
      "request": { "method": "GET", "url": "{{base_url}}/v1/jobs/{{job_id}}" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 with stages', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().stages.length).to.be.above(0); });"
      ] } }]
    }
  ]
}
